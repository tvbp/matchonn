# Anthropic API key for the AI advisor chat. If unset, the advisor falls back
# to a deterministic rule-based needs-analysis flow (no external calls).
ANTHROPIC_API_KEY=

# Password required to view the internal leads dashboard at /admin.
ADMIN_PASSWORD=change-me

# WhatsApp number (with country code, no +) leads are handed off to for a
# human licensed advisor conversation, e.g. 919876543210
# Prefixed NEXT_PUBLIC_ because the "chat on WhatsApp" button builds this
# link client-side; it's just a business contact number, not a secret.
NEXT_PUBLIC_ADVISOR_WHATSAPP_NUMBER=910000000000
